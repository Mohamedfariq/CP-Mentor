MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=cp_mentor
MONGO_COLLECTION_NAME=user_details

# Comma-separated list, e.g. http://127.0.0.1:5173,http://localhost:5173,https://your-frontend.vercel.app
ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional tuning
MIN_PASSWORD_LENGTH=8
CF_API_CACHE_TTL_SECONDS=120
CF_STATUS_CACHE_TTL_SECONDS=120
WEEKLY_CONTEST_DURATION_SECONDS=7200

# Optional: paste Codeforces session cookies if some submission pages need auth
# Example format: JSESSIONID=...; 39ce7=...
CODEFORCES_COOKIE=

# Optional Mongo collections for dynamic model updates
MONGO_TRAINING_SNAPSHOTS_COLLECTION=training_snapshots
MONGO_MODEL_META_COLLECTION=model_meta

# Cluster model behavior
CLUSTER_MODEL_STRICT=false
CLUSTER_RETRAIN_ENABLED=false
CLUSTER_RETRAIN_EVERY_N_USERS=10
CLUSTER_RETRAIN_MIN_INTERVAL_SECONDS=3600
CLUSTER_RETRAIN_MIN_TOTAL_USERS=20
CLUSTER_RETRAIN_MAX_CLUSTERS=12
ALLOW_CLUSTER_CENTROID_FALLBACK=true
